{
  "bridgeRootDir": "D:/xm/agent/.xm-agent/xshell-bridge",
  "defaultSessionId": "default",
  "sessionStaleAfterMs": 15000,
  "dangerousCommands": {
    "builtinRulesEnabled": true,
    "blockedPatterns": [
      "\\bcurl\\b.*\\|\\s*(sh|bash)\\b",
      "\\bwget\\b.*\\|\\s*(sh|bash)\\b"
    ],
    "blockedLiterals": ["rm -rf /", "format c:"]
  }
}
